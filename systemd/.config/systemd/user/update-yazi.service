[Unit]
Description=Check and update Yazi from github

[Service]
Type=oneshot
ExecStart=/home/jim/.config/scripts/update-yazi.sh
# Route notifications to display screen 0
Environment=DISPLAY=:0
# Point directly to your user's live desktop message bus
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# --- ADD THESE TWO LINES TO LOG TO A FILE ---
StandardOutput=append:/home/jim/.config/scripts/yazi-updater.log
StandardError=inherit
# --------------------------------------------

[Install]
WantedBy=default.target

